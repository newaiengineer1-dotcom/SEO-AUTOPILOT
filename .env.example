# Copy to .env (never commit .env). On Streamlit Cloud use Settings -> Secrets instead.
GROQ_API_KEY=
GROQ_MODEL=groq/llama-3.3-70b-versatile      # verify current model IDs at console.groq.com
GROQ_FAST_MODEL=groq/llama-3.1-8b-instant
GROQ_MAX_RPM=20

GITHUB_TOKEN=                                 # fine-grained token: ONLY the website repo; Contents + Pull requests (read/write)
SITE_REPO=owner/kunergy-website
SITE_BRANCH=main
SITE_URL=https://www.kunergy.com

PAGESPEED_API_KEY=                            # optional (free; higher quota)
GSC_CREDENTIALS=                              # optional: service-account JSON (or path)
GSC_SITE_URL=sc-domain:kunergy.com

APP_PASSWORD=                                 # REQUIRED for any public deployment
ALLOW_AUTOMERGE_LOW_RISK=false
